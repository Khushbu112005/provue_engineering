# Database connection string (e.g. Supabase, Neon, or local Postgres)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/provue_tara"

# OpenAI API Key for agent execution
OPENAI_API_KEY="sk-proj-..."

# Optional system date to anchor relative dates (e.g. last month, last quarter).
# If omitted, system date defaults to the latest transaction date in the dataset.
SYSTEM_DATE="2025-03-31"

# Express server port
PORT=3000

# Node Environment
NODE_ENV=development
